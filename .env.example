# AP (Atlante Project) — cadastro de defeito
# Copie este arquivo para `.env` NA RAIZ do repositorio e preencha os valores
# reais. Este arquivo (.env.example) e um MODELO e vai pro git — nunca ponha
# credencial real aqui. O `.env` esta no .gitignore.
#
#   cp .env.example .env
#
# Sem estas variaveis o kit inteiro funciona; so o /qa-defeito para de
# cadastrar no AP e deixa o rascunho em bugs/.

# URL base da instalacao, SEM barra no final e SEM caminho de documentacao.
# Inclua /index.php se a sua instalacao usa essa rota.
# ex: https://ap.suaempresa.com.br/index.php
RISE_BASE_URL=

# Credenciais de ESCRITA (login por sessao em /tasks/save).
# Use um usuario de servico dedicado, nunca a conta pessoal de alguem: quando a
# pessoa sai da empresa a automacao nao morre junto, e o historico nao fica com
# o nome errado.
RISE_USER=
RISE_PASSWORD=

# Token de LEITURA, gerado em: Admin -> API Management -> criar usuario/token.
# Opcional. Sem ele o cadastro continua funcionando; voce so perde a lista real
# de projetos e a validacao de membros no preview.
RISE_AUTH_TOKEN=
