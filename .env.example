# RISE CRM — REST API
# Copie este arquivo para `.env` e preencha os valores reais.
# Este arquivo (.env.example) e um MODELO e vai pro git — nunca ponha
# credenciais reais aqui. O `.env` esta no .gitignore.

# URL base da instalacao, SEM barra no final e SEM caminho de documentacao.
# Inclua /index.php se a sua instalacao usa essa rota.
# ex: https://crm.suaempresa.com.br/index.php
RISE_BASE_URL=

# Token gerado em: Admin -> API Management -> criar usuario/token
RISE_AUTH_TOKEN=
